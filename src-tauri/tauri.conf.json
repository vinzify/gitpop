{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPop",
  "version": "1.5.0-beta.1",
  "identifier": "com.vinzify.gitpop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCMkI3RjIwNzE0MjZGQjQKUldTMGIwSnhJSDhyQzdZWXFJN1c4THlWODFaQjBMY1M0Z3cyWDNoMVdJWXRwNmIvZmRNZWVTcjkK",
      "endpoints": [
        "https://raw.githubusercontent.com/vinzify/gitpop/main/preview.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "GitPop",
        "width": 1080,
        "height": 780,
        "minWidth": 700,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A focused Git workbench with optional AI suggestions",
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
